---
// Wires every page together: SEO head, optional schema graph, the fixed
// header/footer/callbar chrome, and the two globally-mounted modals
// (site-wide contact form, reputation widget) that any page can trigger
// via data-modal-target. See Skeleton-Build-Spec.md §6.
import SeoHead from "../components/SeoHead.astro";
import GoogleTags from "../components/GoogleTags.astro";
import SchemaGraph from "../components/SchemaGraph.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCallbar from "../components/MobileCallbar.astro";
import Modal from "../components/Modal.astro";
import GravityFormEmbed from "../components/GravityFormEmbed.astro";
import ReputationWidget from "../components/ReputationWidget.astro";
import AccessibilityWidget from "../components/AccessibilityWidget.astro";
import MotionLayer from "../components/MotionLayer.astro";
import { getSiteSchemaNodes, buildBreadcrumb, normalizeIds } from "../lib/schema/organization";
import { getImage } from "astro:assets";
import { getSiteInfo } from "../lib/data/site";
import tokensRaw from "../styles/tokens.css?raw";
import "../styles/tokens.css";
import "../styles/icon-font.css";
import "../styles/fonts.css";
import type { ImageMetadata } from "astro";

// Preload the two highest-impact font FILES (not just the stylesheet) for
// the current typeface — the body-text weight (400) and the weight
// headings/buttons actually render at (700: no component sets heading
// font-weight explicitly, so h1-h6 use the browser's own default bold).
// `?url` resolves to the real hashed build output path. Swapping the
// typeface in styles/fonts.css? Update these two paths to match (or drop
// the preload if the new choice doesn't warrant it) — see that file.
import bodyLatin400 from "@fontsource/figtree/files/figtree-latin-400-normal.woff2?url";
import headingLatin600 from "@fontsource/outfit/files/outfit-latin-600-normal.woff2?url";

export interface Props {
  title: string; // page-specific title segment (e.g. "Contact Us") unless titleTemplate="full"
  description?: string; // falls back to a generic sentence if omitted — real copy is a launch task, not a build one
  canonical?: string; // override; default is Astro.url resolved against the configured domain — pages don't need to set this
  ogImage?: ImageMetadata | string; // page-specific social image (e.g. a blog post's or service's cover); falls back to public/og-default.png
  ogType?: "website" | "article";
  ogImageAlt?: string; // alt text for the social image (collection pages pass their feature image's alt)
  /** "page" (default): title becomes "{title} | {practiceName}" (omitted if that exceeds 60 chars, per the
   *  agency's webflow-prelaunch-meta skill — never truncated). "full": use `title` exactly as given
   *  (the homepage composes its own brand-first title, e.g. "{practiceName} | Veterinary Care"). */
  titleTemplate?: "page" | "full";
  noindex?: boolean;
  schemaGraph?: Record<string, any>[]; // page-specific nodes, see Skeleton-Build-Spec.md §9
  /** Merged into this page's WebPage node, e.g. { "@type": "AboutPage" } or { mainEntity: { "@id": "#service" } }. */
  webPage?: Record<string, any>;
  /** Breadcrumb label for this page (defaults to `title`); false = no breadcrumb. */
  breadcrumb?: string | false;
}

const { title, description, canonical, ogImage, ogImageAlt, ogType, titleTemplate = "page", noindex, schemaGraph, webPage, breadcrumb } = Astro.props;
const site = await getSiteInfo();

// Title: see the Props doc comment above for the two modes.
const finalTitle = (() => {
  if (titleTemplate === "full") return title;
  const withSuffix = `${title} | ${site.practiceName}`;
  return withSuffix.length <= 60 ? withSuffix : title;
})();

// Astro.site always resolves — astro.config.mjs sets it from site.ts's `url`
// field, which ships with a non-empty placeholder — but the type is still
// `URL | undefined`, so fall back defensively rather than assert it away.
const siteOrigin = Astro.site ?? new URL("https://example.com");
const toAbsolute = (path: string) => new URL(path, siteOrigin).href;

// Canonical: auto-derived from the current request path unless a page opts
// out. No page needs to pass this in normal use.
const canonicalUrl = canonical ?? toAbsolute(Astro.url.pathname);

// OG/Twitter image: a page's own cover image (blog post, service) if given,
// else the sitewide placeholder — see public/og-default.png (swap that file
// in place per client; no code change needed, per direct instruction).
// A collection page's cover (ImageMetadata) is cropped to the 1200×630
// social-card size as a JPEG instead of sharing the raw full-size photo.
const ogCrop = ogImage && typeof ogImage !== "string"
  ? await getImage({ src: ogImage, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 })
  : undefined;
const resolvedOgImage = toAbsolute(ogCrop?.src ?? (typeof ogImage === "string" ? ogImage : "/og-default.png"));
const ogImageSize = ogCrop || !ogImage ? { width: 1200, height: 630 } : undefined;
const resolvedOgImageAlt = ogImageAlt ?? (ogImage ? undefined : site.practiceName);

// Preview build: SITE_URL (astro.config.mjs) points the build at a host other
// than the production domain, e.g. the workers.dev address before DNS moves.
// Keep it out of search results; robots.txt disallows it too.
const isPreviewBuild = !!site.url && siteOrigin.origin !== new URL(site.url).origin;

// theme-color: read --main straight out of tokens.css (via Vite's ?raw
// import above) so it always matches the current brand palette with zero
// duplication — never hard-code a hex here. --main is Tier 1 (see
// tokens.css), always a literal hex, never a var() reference, so a plain
// regex is enough; no need for the fuller resolver in scripts/lib/palette.mjs.
const themeColor = tokensRaw.match(/--main:\s*(#[0-9a-fA-F]{3,8})/)?.[1];

// Description: every page ships with SOME description — real per-page copy
// is a launch-time content task (see Plan.md §8, B1), not something to
// generate here, but a page shipping with none at all is a worse default.
const finalDescription =
  description?.trim() || `${site.practiceName} — compassionate veterinary care${site.cityState ? ` in ${site.cityState}` : ""}.`;

// JSON-LD: site-wide nodes (WebSite, Business — see lib/schema/organization.ts)
// + this page's WebPage + BreadcrumbList + the page's own nodes, with every
// short @id made absolute. A page's nodes reference {"@id": "#business"} etc.
// without re-declaring org info.
const breadcrumbNode = breadcrumb === false ? undefined : buildBreadcrumb(Astro.url.pathname, breadcrumb || title, siteOrigin);
const webPageNode = {
  "@type": "WebPage",
  "@id": "#webpage",
  url: canonicalUrl,
  name: finalTitle,
  description: finalDescription,
  isPartOf: { "@id": "#website" },
  about: { "@id": "#business" },
  primaryImageOfPage: { "@type": "ImageObject", url: resolvedOgImage },
  inLanguage: "en-US",
  ...(breadcrumbNode ? { breadcrumb: { "@id": "#breadcrumb" } } : {}),
  ...(webPage || {}),
};
const graph = normalizeIds(
  [...(await getSiteSchemaNodes(siteOrigin)), webPageNode, ...(breadcrumbNode ? [breadcrumbNode] : []), ...(schemaGraph || [])],
  siteOrigin,
  canonicalUrl
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={bodyLatin400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingLatin600} as="font" type="font/woff2" crossorigin />
    <SeoHead
      title={finalTitle}
      description={finalDescription}
      canonical={canonicalUrl}
      ogImage={resolvedOgImage}
      ogImageWidth={ogImageSize?.width}
      ogImageHeight={ogImageSize?.height}
      ogImageAlt={resolvedOgImageAlt}
      ogType={ogType}
      themeColor={themeColor}
      noindex={noindex || isPreviewBuild}
    />
    <SchemaGraph graph={graph} />
    <MotionLayer />
    <GoogleTags />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MobileCallbar />

    <Modal id="contact-modal">
      <GravityFormEmbed formId="contact" context="modal" heading="Contact Us" />
    </Modal>
    <ReputationWidget />
    <AccessibilityWidget />

    <style is:global>
      :root { box-sizing: border-box; }
      *, *::before, *::after { box-sizing: inherit; }
      body { margin: 0; font-family: var(--font-body); color: var(--text); line-height: 1.5; }
      img { max-width: 100%; height: auto; display: block; }
      /* Base typography + focus — token-driven so re-skinning never touches components.
         :where() keeps specificity at zero so any component rule still wins. Sections on
         dark backgrounds (Hero, PageHeaderBanner, CtaBand) set color: inherit on their
         headings; a new dark section must do the same. */
      :where(h1, h2, h3, h4, h5, h6) { color: var(--heading); font-family: var(--font-heading); }
      :where(a) { color: var(--main); }
      :focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 2px; }
      /* The header is opaque (always white), so every page starts below it. */
      main { padding-block-start: var(--header-height); padding-block-end: 0; }
      @media (max-width: 900px) { main { padding-block-end: var(--callbar-height); } }
      body.has-open-modal { overflow: hidden; }

      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
      .skip-link { position: absolute; inset-inline-start: -999px; inset-block-start: 0; z-index: 200; background: var(--main); color: var(--on-main); padding: var(--space-sm) var(--space-md); }
      .skip-link:focus { inset-inline-start: 0; }

      /* Shared primitives (design shared with sister site Durham): pill buttons with a nested
         trailing icon, eyebrow tags. Pages and components reuse these. */
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: var(--space-sm);
        min-height: 3.25rem; padding: var(--space-xs) var(--space-lg); border-radius: var(--radius-pill);
        border: 2px solid transparent; font-family: var(--font-body); font-weight: 600; font-size: var(--font-size-md);
        text-decoration: none; line-height: 1.2; white-space: nowrap; cursor: pointer;
        transition: transform var(--motion-duration-base) var(--motion-ease), background-color var(--motion-duration-base) var(--motion-ease), color var(--motion-duration-base) var(--motion-ease), border-color var(--motion-duration-base) var(--motion-ease);
      }
      .btn:active { transform: scale(0.98); }
      .btn--cta { background: var(--cta); color: var(--on-cta); }
      .btn--cta:hover { background: var(--cta-hover); color: var(--on-cta); }
      .btn--main { background: var(--main); color: var(--on-main); }
      .btn--main:hover { background: var(--main-light); color: var(--on-main); }
      .btn--outline { border-color: var(--main); color: var(--main); background: transparent; }
      .btn--outline:hover { background: var(--main); color: var(--on-main); }
      .btn--ghost-light { border-color: var(--white-o85); color: var(--white); background: transparent; }
      .btn--ghost-light:hover { background: var(--white); color: var(--main-dark); }
      .btn--has-icon { padding-inline-end: var(--space-2xs); }
      .btn__icon {
        display: inline-grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: var(--radius-pill);
        background: var(--main-dark); color: var(--white); font-size: var(--font-size-md);
        transition: transform var(--motion-duration-base) var(--motion-ease);
      }
      .btn:hover .btn__icon { transform: translateX(3px) scale(1.05); }
      .eyebrow {
        display: inline-flex; align-items: center; gap: var(--space-xs); padding: var(--space-2xs) var(--space-sm);
        border-radius: var(--radius-pill); background: var(--solid-bg); color: var(--main);
        font-size: var(--font-size-xs); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
      }
      .eyebrow--on-dark { background: var(--white-o85); color: var(--main-dark); }
      .eyebrow--plain { background: none; padding-inline: 0; }
      .nowrap { white-space: nowrap; }
      /* Content pages ported from the client's site (Your First Visit, Careers…). */
      .page-body { max-width: var(--container-max-narrow); margin-inline: auto; padding: var(--space-2xl) var(--space-md); }
      .prose { font-size: var(--font-size-md); line-height: 1.75; }
      .prose :where(h2) { font-size: var(--font-size-3xl); line-height: 1.15; margin: var(--space-xl) 0 var(--space-md); }
      .prose :where(h3) { font-size: var(--font-size-lg); margin: var(--space-lg) 0 var(--space-sm); }
      .prose :where(p, ul, ol) { margin: 0 0 var(--space-md); }
      .prose :where(li) { margin-block-end: var(--space-2xs); }
      .prose > :first-child { margin-block-start: 0; }
      .callout { padding: var(--space-lg); border-radius: var(--radius-xl); background: var(--solid-bg); }
    </style>
  </body>
</html>
