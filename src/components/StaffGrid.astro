---
// CMS-powered. See Skeleton-Build-Spec.md §6.
import StaffCard from "./StaffCard.astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  staff: CollectionEntry<"staff">[];
}
const { staff } = Astro.props;
---

<div class="staff-grid">
  {staff.map((staffMember) => <StaffCard staffMember={staffMember} />)}
</div>

<style>
  /* At most 4 staff cards per row (Constanza, 2026-10-28). */
  .staff-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-xl) var(--space-lg); }
  @media (max-width: 900px) { .staff-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 767px) { .staff-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
