---
// CMS-powered. See Skeleton-Build-Spec.md §6.
import DoctorCard from "./DoctorCard.astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  doctors: CollectionEntry<"doctors">[];
}
const { doctors } = Astro.props;
---

<div class="doctor-grid">
  {doctors.map((doctor) => <DoctorCard doctor={doctor} />)}
</div>

<style>
  .doctor-grid { display: grid; gap: var(--space-lg); }
</style>
