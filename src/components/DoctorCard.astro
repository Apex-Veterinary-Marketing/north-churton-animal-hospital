---
// CMS-powered doctor card for Meet the Team. Doctors get the featured, wide
// treatment (photo + short bio side by side); the full bio opens in a modal
// instead of sending people to another page (Constanza, 2026-10-28). The
// /doctors/[slug] page still exists for SEO and the blog author link.
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Modal from "./Modal.astro";
import { initialsOf } from "../lib/utils/initials";

export interface Props {
  doctor: CollectionEntry<"doctors">;
}
const { doctor } = Astro.props;
const modalId = `bio-${doctor.id}`;
// No headshot yet → a branded monogram instead of a generic avatar.
const initials = initialsOf(doctor.data.name);
---

<article class="doctor-card">
  <div class="doctor-card__media">
    {doctor.data.mainImage ? (
      <Image src={doctor.data.mainImage} alt={doctor.data.imageAltText || doctor.data.name} class="doctor-card__image" />
    ) : (
      <span class="doctor-card__monogram" aria-hidden="true">{initials}</span>
    )}
  </div>
  <div class="doctor-card__body">
    <span class="eyebrow">Veterinarian</span>
    <h3 class="doctor-card__name">{doctor.data.name}</h3>
    {doctor.data.bioShort && <div class="doctor-card__bio" set:html={doctor.data.bioShort} />}
    <div class="doctor-card__actions">
      {doctor.data.bio && (
        <button type="button" class="btn btn--outline doctor-card__more" data-modal-target={modalId}>Read full bio</button>
      )}
      <a class="doctor-card__profile" href={`/doctors/${doctor.id}`}>View profile <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</article>

{doctor.data.bio && (
  <Modal id={modalId}>
    <div class="bio-modal">
      <h2 class="bio-modal__name">{doctor.data.name}</h2>
      <div class="bio-modal__text" set:html={doctor.data.bio} />
    </div>
  </Modal>
)}

<style>
  .doctor-card { display: grid; grid-template-columns: minmax(12rem, 20rem) 1fr; gap: var(--space-xl); align-items: center; padding: var(--space-lg); border-radius: var(--radius-xl); background: var(--solid-bg); }
  .doctor-card__image, .doctor-card__monogram { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: calc(var(--radius-xl) - var(--space-xs)); }
  .doctor-card__monogram { display: grid; place-items: center; background: var(--main); color: var(--white); font-family: var(--font-heading); font-size: var(--font-size-hero); font-weight: 600; }
  .doctor-card__name { margin: var(--space-sm) 0; font-size: var(--font-size-3xl); line-height: 1.1; }
  .doctor-card__bio :global(p) { margin: 0 0 var(--space-md); font-size: var(--font-size-md); line-height: 1.7; }
  .doctor-card__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-sm) var(--space-lg); margin-block-start: var(--space-xs); }
  .doctor-card__profile { font-weight: 600; text-decoration: none; }
  .doctor-card__profile:hover { color: var(--main-light); }
  .bio-modal__name { margin: 0 0 var(--space-md); padding-inline-end: var(--space-xl); }
  .bio-modal__text :global(p) { line-height: 1.7; }
  @media (max-width: 767px) {
    .doctor-card { grid-template-columns: 1fr; gap: var(--space-lg); }
  }
</style>
