---
// Homepage: a full-height background-video hero (agency stock
// footage, mirrored so the dog sits opposite the text; on phones the video
// shows uncropped above the text, so the dog is never cut off), hero pills as the ONE place the practice's highlights appear
// (no separate stat strip or floating note repeating them), then welcome,
// services, the featured doctor(s) and the visit block with payment logos.
import { Image } from "astro:assets";
import { getHomeData } from "../../lib/data/home";
import { phoneHref } from "../../lib/utils/phone";
import { initialsOf } from "../../lib/utils/initials";
import HomeVisit from "./HomeVisit.astro";
import TestimonialSlider from "../TestimonialSlider.astro";
import PawTrail from "../PawTrail.astro";
import { getAllTestimonials } from "../../lib/data/testimonials";
import welcomePhoto from "../../assets/site/owner-holding-cat.jpg";

const { site, services, doctors, headline, lede, highlights, welcome, heroVideo } = await getHomeData();
// Real reviews from the client's old Reviews page; strongest and most recent first.
const REVIEW_ORDER = ["mohona-s", "claire-c", "colleen-d", "danielle-c", "roxane-l", "joseph-m"];
const reviews = (await getAllTestimonials())
  .filter((t) => REVIEW_ORDER.includes(t.id))
  .sort((a, b) => REVIEW_ORDER.indexOf(a.id) - REVIEW_ORDER.indexOf(b.id));
---

<div class="home">
  <section class="a-hero">
    {/* Plays only when the visitor hasn't asked for reduced motion; the pause button meets WCAG 2.2.2 (moving content > 5s). */}
    <div class="a-hero__media">
      <video class="a-hero__video" style={`object-position: ${heroVideo.position}`} muted loop playsinline preload="metadata" poster={heroVideo.poster} aria-hidden="true" data-hero-video>
        <source src={heroVideo.src} type="video/mp4" />
      </video>
      <button type="button" class="a-hero__toggle" data-hero-video-toggle aria-pressed="false" hidden>
        <span class="a-hero__toggle-icon" aria-hidden="true"></span><span data-hero-video-label>Pause video</span>
      </button>
    </div>
    <div class="a-hero__scrim" aria-hidden="true"></div>
    <div class="a-hero__inner">
      <span class="eyebrow eyebrow--on-dark" data-animate="fade">Veterinary hospital &middot; {site.cityState}</span>
      <h1 class="a-hero__title">{headline}</h1>
      <p class="a-hero__lede">{lede}</p>
      {/* Hero actions (Constanza, 2026-10-29): Pet Portal like both old sites, plus services. The phone lives in the header and call bar. */}
      <div class="a-hero__actions">
        {site.portalUrl ? (
          <a class="btn btn--cta btn--has-icon" href={site.portalUrl} target="_blank" rel="noopener">Pet Portal <span class="btn__icon" aria-hidden="true">&rarr;</span></a>
        ) : (
          <a class="btn btn--cta btn--has-icon" href={site.bookingUrl}>{site.bookingLabel} <span class="btn__icon" aria-hidden="true">&rarr;</span></a>
        )}
        <a class="btn btn--ghost-light" href="/services">Our Services</a>
      </div>
      <ul class="a-pills">
        {highlights.map((h) => <li><span class="a-pills__dot" aria-hidden="true"></span>{h}</li>)}
      </ul>
    </div>
  </section>

  <section class="a-welcome">
    <PawTrail placement="bottom-left" />
    <div class="a-welcome__inner">
      <div class="a-welcome__media" data-reveal>
        <div class="a-frame">
          <Image src={welcomePhoto} alt="Owner gently holding a gray-and-white cat" width={690} class="a-frame__img" />
        </div>
      </div>
      <div class="a-welcome__copy" data-reveal>
        <span class="eyebrow">Welcome to {site.practiceName}</span>
        <h2 class="a-h2">Your neighborhood vet for every stage of life</h2>
        {welcome.map((p) => <p>{p}</p>)}
        <a class="btn btn--outline" href="/meet-the-team">Meet our team</a>
      </div>
    </div>
  </section>

  <section class="a-services">
    <PawTrail placement="top-right" />
    <div class="a-head" data-reveal>
      <span class="eyebrow">Our services</span>
      <h2 class="a-h2">Wellness, dentistry and surgery under one roof</h2>
    </div>
    <ul class="a-cards" data-reveal-stagger>
      {services.map((s) => (
        <li data-reveal>
          <a class="a-card" href={s.href}>
            {s.icon && <span class="a-card__icon"><Image src={s.icon} alt="" width={64} height={64} /></span>}
            <span class="a-card__title">{s.label}</span>
            <span class="a-card__text">{s.blurb}</span>
            <span class="a-card__more">Learn more <span aria-hidden="true">&rarr;</span></span>
          </a>
        </li>
      ))}
    </ul>
    <div class="a-center"><a class="btn btn--main" href="/services">See all services</a></div>
  </section>

  {doctors.length > 0 && (
    <section class="a-doctor">
      <PawTrail placement="top-left" tone="light" />
      <div class="a-head a-head--on-dark" data-reveal>
        <span class="eyebrow eyebrow--on-dark">Meet your veterinarian{doctors.length > 1 ? "s" : ""}</span>
      </div>
      <div class:list={["a-doctor__list", doctors.length > 1 && "a-doctor__list--multi"]}>
        {doctors.map((doctor) => (
          <div class="a-doctor__inner" data-reveal>
            {doctor.data.mainImage ? (
              <Image src={doctor.data.mainImage} alt={doctor.data.imageAltText || doctor.data.name} width={480} class="a-doctor__portrait a-doctor__photo" />
            ) : (
              <div class="a-doctor__portrait" aria-hidden="true">{initialsOf(doctor.data.name)}</div>
            )}
            <div class="a-doctor__copy">
              <h2 class="a-h2">{doctor.data.name}</h2>
              <div class="a-doctor__bio" set:html={doctor.data.bioShort} />
            </div>
          </div>
        ))}
      </div>
      <div class="a-center"><a class="btn btn--ghost-light" href="/meet-the-team">Meet our team</a></div>
    </section>
  )}

  {reviews.length > 0 && (
    <section class="a-reviews">
      <PawTrail placement="bottom-right" />
      <div class="a-head" data-reveal>
        <span class="eyebrow">Reviews</span>
        <h2 class="a-h2">What {site.addressLocality} pet owners say</h2>
      </div>
      <TestimonialSlider testimonials={reviews.map((t) => ({ name: t.data.name, testimonial: t.data.testimonial }))} />
      <div class="a-center a-reviews__actions">
        {site.googleReviewsLink && (
          <a class="btn btn--cta btn--has-icon" href={site.googleReviewsLink} target="_blank" rel="noopener">Leave us a Google review <span class="btn__icon" aria-hidden="true">&rarr;</span></a>
        )}
        <a class="btn btn--outline" href="/reviews">Read all reviews</a>
      </div>
    </section>
  )}

  <HomeVisit tone="soft" />
</div>


<script>
  // Hero video: autoplay only without prefers-reduced-motion; a visible pause/play toggle.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-hero-video-toggle]");
  const label = toggle?.querySelector<HTMLElement>("[data-hero-video-label]");
  if (video && toggle && label) {
    const sync = () => {
      const paused = video.paused;
      toggle.setAttribute("aria-pressed", String(paused));
      label.textContent = paused ? "Play video" : "Pause video";
    };
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    toggle.addEventListener("click", () => (video.paused ? video.play() : video.pause()));
    toggle.hidden = false;
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) video.play().catch(sync);
    sync();
  }
</script>

<style>
  /* Sections host decorative paw trails behind their content. */
  .a-welcome, .a-services, .a-doctor, .a-reviews { position: relative; isolation: isolate; overflow: hidden; }
  .a-h2 { font-size: var(--font-size-section); line-height: 1.1; letter-spacing: -0.01em; margin: var(--space-md) 0 var(--space-lg); }
  .a-head { max-width: 46rem; margin: 0 auto var(--space-2xl); text-align: center; }
  .a-center { text-align: center; margin-block-start: var(--space-xl); }

  /* Hero */
  /* Fills the screen below the fixed header. */
  .a-hero { position: relative; min-height: calc(100dvh - var(--header-height)); display: flex; align-items: center; color: var(--white); overflow: hidden; background: var(--main-dark); }
  /* Full viewport height; the focal point (the dog) is set per site in home.ts. */
  .a-hero__media { position: absolute; inset: 0; }
  .a-hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .a-hero__toggle { position: absolute; z-index: 1; inset-inline-end: var(--space-md); inset-block-end: var(--space-md); display: inline-flex; align-items: center; gap: var(--space-xs); padding: var(--space-2xs) var(--space-sm); border: 1px solid var(--white-o85); border-radius: var(--radius-pill); background: var(--main-o50); color: var(--white); font: inherit; font-size: var(--font-size-xs); font-weight: 600; cursor: pointer; }
  .a-hero__toggle:hover { background: var(--main); }
  .a-hero__toggle-icon { width: 0.7rem; height: 0.7rem; border-inline: 3px solid currentColor; box-sizing: border-box; }
  .a-hero__toggle[aria-pressed="true"] .a-hero__toggle-icon { border: 0; border-block: 0.35rem solid transparent; border-inline-start: 0.6rem solid currentColor; width: 0; height: 0; }
  .a-hero__scrim { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(90deg, var(--alt-bg) 0%, var(--main-o50) 55%, transparent 100%); }
  .a-hero__inner { position: relative; width: 100%; max-width: var(--container-max); margin-inline: auto; padding: var(--space-xl) var(--space-md) var(--space-3xl); }
  .a-hero__title { color: inherit; font-size: var(--font-size-hero); line-height: 1.02; letter-spacing: -0.02em; margin: var(--space-lg) 0; max-width: 13ch; }
  .a-hero__lede { font-size: var(--font-size-lg); line-height: 1.6; max-width: 34rem; margin: 0 0 var(--space-xl); color: var(--white); }
  .a-hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); }
  .a-pills { list-style: none; margin: var(--space-xl) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-xs); }
  .a-pills li { display: inline-flex; align-items: center; gap: var(--space-xs); padding: var(--space-xs) var(--space-md); border-radius: var(--radius-pill); background: var(--main-o50); border: 1px solid var(--main-soft-o50); font-size: var(--font-size-sm); font-weight: 600; }
  .a-pills__dot { width: 0.5rem; height: 0.5rem; border-radius: var(--radius-pill); background: var(--cta); }

  /* Framed photo (outer shell + inner core) */
  .a-frame { padding: var(--space-xs); border-radius: var(--radius-xl); background: var(--solid-bg); }
  .a-frame__img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: calc(var(--radius-xl) - var(--space-xs)); }

  /* Welcome */
  .a-welcome { background: var(--white); padding: var(--space-3xl) var(--space-md); }
  .a-welcome__inner { max-width: var(--container-max); margin-inline: auto; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2xl); align-items: center; }
  .a-welcome__copy p { font-size: var(--font-size-md); line-height: 1.7; margin: 0 0 var(--space-md); }
  .a-welcome__copy .btn { margin-block-start: var(--space-md); }

  /* Services */
  .a-services { background: var(--solid-bg); padding: var(--space-3xl) var(--space-md); }
  .a-cards { list-style: none; margin: 0 auto; padding: 0; max-width: var(--container-max); display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-lg); }
  .a-cards li { display: flex; }
  .a-card { flex: 1; display: flex; flex-direction: column; gap: var(--space-sm); padding: var(--space-xl) var(--space-lg); border-radius: var(--radius-xl); background: var(--white); color: var(--text); text-decoration: none; box-shadow: var(--shadow-soft); transition: transform var(--motion-duration-base) var(--motion-ease); }
  .a-card:hover { transform: translateY(-4px); }
  .a-card__icon { display: grid; place-items: center; width: 4.5rem; height: 4.5rem; border-radius: var(--radius-pill); background: var(--solid-bg); }
  .a-card__icon img { width: 3rem; height: 3rem; object-fit: contain; }
  .a-card__title { font-family: var(--font-heading); font-size: var(--font-size-2xl); font-weight: 600; color: var(--heading); line-height: 1.2; }
  .a-card__text { color: var(--text-muted); flex: 1; }
  .a-card__more { color: var(--main); font-weight: 600; }

  /* Reviews */
  .a-reviews { background: var(--white); padding: var(--space-3xl) var(--space-md); }
  .a-reviews__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-sm); }

  /* Doctor */
  .a-doctor { background: var(--main); color: var(--white); padding: var(--space-3xl) var(--space-md); }
  .a-head--on-dark { margin-block-end: var(--space-xl); }
  .a-doctor__list { max-width: 60rem; margin-inline: auto; display: grid; gap: var(--space-2xl); }
  /* Two or more doctors: side by side, portrait above the text. */
  .a-doctor__list--multi { max-width: var(--container-max); grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .a-doctor__list--multi .a-doctor__inner { grid-template-columns: 9rem 1fr; align-items: start; }
  .a-doctor__list--multi .a-doctor__portrait { font-size: var(--font-size-3xl); }
  .a-doctor__inner { display: grid; grid-template-columns: 16rem 1fr; gap: var(--space-xl); align-items: center; }
  .a-doctor__portrait { display: grid; place-items: center; aspect-ratio: 4 / 5; border-radius: var(--radius-xl); background: var(--main-soft); color: var(--white); font-family: var(--font-heading); font-size: var(--font-size-hero); font-weight: 600; box-shadow: var(--shadow-soft); }
  .a-doctor__photo { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; }
  .a-doctor .a-h2 { color: inherit; }
  .a-doctor__bio :global(p) { font-size: var(--font-size-md); line-height: 1.7; margin: 0 0 var(--space-lg); }

  @media (max-width: 900px) {
    .a-welcome__inner { grid-template-columns: 1fr; }
    .a-cards { grid-template-columns: 1fr 1fr; }
    .a-doctor__list--multi { grid-template-columns: 1fr; }
    .a-doctor__inner, .a-doctor__list--multi .a-doctor__inner { grid-template-columns: 1fr; text-align: center; }
    .a-doctor__portrait { width: 12rem; margin-inline: auto; }
    .a-hero__scrim { background: var(--alt-bg); }
  }
  /* Phones: show the whole 16:9 video (dog uncropped) above the text; the hero still fills the screen. */
  @media (max-width: 767px) {
    .a-hero { flex-direction: column; align-items: stretch; justify-content: flex-start; }
    .a-hero__media { position: relative; inset: auto; aspect-ratio: 16 / 9; }
    .a-hero__scrim { display: none; }
    .a-hero__inner { padding-block-start: var(--space-xl); }
  }
  @media (max-width: 767px) {
    .a-welcome, .a-services, .a-doctor { padding-block: var(--space-2xl); }
    .a-hero__inner { padding-block-end: var(--space-2xl); }
    .a-cards { grid-template-columns: 1fr; }
  }
</style>
