---
// Meet the Team. Section order set 2026-09-08 by direct instruction:
// header banner, doctors grid, about-the-clinic (mission/vision/approach-
// shaped blurbs, deliberately not labeled with those words), about-the-
// team paragraph, staff grid. The three-blurb grid is page-specific markup
// (not promoted to a shared component) since it's the only page that needs
// it right now — revisit if another page wants the same pattern.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
import DoctorGrid from "../components/DoctorGrid.astro";
import StaffGrid from "../components/StaffGrid.astro";
import PawTrail from "../components/PawTrail.astro";
import { getAllDoctors } from "../lib/data/doctors";
import { getAllStaff } from "../lib/data/staff";
import { getSiteInfo } from "../lib/data/site";
import aboutPhoto from "../assets/site/banners/cat-63.jpg";
import bannerPhoto from "../assets/site/kitten-and-puppy-cuddling.jpg";

const doctors = await getAllDoctors();
const staff = await getAllStaff();
const site = await getSiteInfo();

const clinicBlurbs = [
  {
    heading: "What We Stand For",
    body: "We're here so Hillsborough families have a veterinary hospital they can count on for the long haul, one that treats their pets the way they do: as family.",
  },
  {
    heading: "Where We're Headed",
    body: "We want to keep earning a place in our clients' lives for generations of pets, growing our wellness, dental and surgical care while staying the friendly hometown hospital Hillsborough knows.",
  },
  {
    heading: "How We Care For Your Pet",
    body: "Every visit starts with listening to you and gently examining your pet from nose to tail. We explain what we find in plain language, share your options, and make a plan together. When your pet is sick, we do our best to see them the same day.",
  },
];
---

<BaseLayout title="Meet the Team" description="Meet Dr. James Miller, Dr. Korinn Saker and the North Churton Animal Hospital team caring for dogs and cats in Hillsborough, NC since 2006.">
  <PageHeaderBanner heading="Meet the Team" image={bannerPhoto} imageAlt="Kitten and puppy cuddling in the grass" />

  {/* Ported from the client's old /about/ page (verbatim except: boarding dropped — no longer
     offered — and Saturday hours left out, per the onboarding form). */}
  <section class="about-practice">
    <PawTrail placement="top-left" />
    <div class="about-practice__inner">
      <div class="about-practice__copy">
        <span class="eyebrow">About our practice</span>
        <h2>North Churton Animal Hospital is a full-service veterinary clinic offering the highest standard of veterinary medicine for your companion.</h2>
        <p>We strive to provide a compassionate and comfortable environment for you and your pet right here in Hillsborough. <strong>We believe in life long wellness care with an emphasis on education and prevention.</strong></p>
        <p>We offer a <a href="/services">wide range of services for your furry family member</a> including wellness and preventive care, vaccinations, elective surgery, dental cleanings, radiography, in-house blood work, <strong>in-house pharmacy</strong> and a wide range of prescription diets just to name a few. We are equipped to treat emergency cases.</p>
        <p>Dr. Miller spends half of his time at North Churton Animal Hospital taking care of furry patients and the other half at <a href="https://durhamanimalhospital.com" target="_blank" rel="noopener">Durham Animal Hospital in Durham, NC</a>.</p>
        <div class="about-practice__actions">
          <a class="btn btn--cta btn--has-icon" href={site.bookingUrl}>{site.bookingLabel} <span class="btn__icon" aria-hidden="true">&rarr;</span></a>
          <a class="btn btn--outline" href="/reviews">Read our reviews</a>
        </div>
      </div>
      <div class="about-practice__media">
        <Image src={aboutPhoto} alt="Two veterinarians examining a Persian cat" widths={[640, 960, 1280]} sizes="(max-width: 900px) 100vw, 40vw" class="about-practice__img" />
      </div>
    </div>
  </section>

  <section class="page-section team">
    <div class="team__intro">
      <span class="eyebrow">About our team</span>
      <h2>Familiar faces who know your pet by name</h2>
      <p class="about-staff__body">Dr. James Miller grew up on a small farm in northern Orange County and founded North Churton Animal Hospital in his hometown of Hillsborough in 2006. Today he and Dr. Korinn Saker lead a close-knit team that gets to know each pet by name. Whether you're bringing in a new puppy or a senior cat, you'll be greeted by familiar faces who care about your pet as much as you do.</p>
    </div>

    {doctors.length > 0 && (
      <div class="team__group">
        <h3 class="team__label">Our Veterinarian{doctors.length > 1 ? "s" : ""}</h3>
        <DoctorGrid doctors={doctors} />
      </div>
    )}

    {staff.length > 0 && (
      <div class="team__group">
        <h3 class="team__label">Our Staff</h3>
        <StaffGrid staff={staff} />
      </div>
    )}
  </section>

  <section class="about-clinic">
    <PawTrail placement="bottom-right" />
    <div class="page-section">
      <h2>About Our Practice</h2>
      <div class="about-clinic__grid">
        {clinicBlurbs.map((blurb) => (
          <div class="about-clinic__item">
            <h3>{blurb.heading}</h3>
            <p>{blurb.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-practice { position: relative; isolation: isolate; overflow: hidden; background: var(--white); padding: var(--space-3xl) var(--space-md) var(--space-xl); }
  .about-practice__inner { max-width: var(--container-max); margin-inline: auto; display: grid; grid-template-columns: 1.15fr 1fr; gap: var(--space-2xl); align-items: center; }
  .about-practice__copy h2 { font-size: var(--font-size-3xl); line-height: 1.15; margin: var(--space-sm) 0 var(--space-lg); }
  .about-practice__copy p { font-size: var(--font-size-md); line-height: 1.75; margin: 0 0 var(--space-md); }
  .about-practice__actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-block-start: var(--space-lg); }
  .about-practice__img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius-xl); box-shadow: var(--shadow-soft); }
  @media (max-width: 900px) {
    .about-practice { padding-block: var(--space-2xl) var(--space-lg); }
    .about-practice__inner { grid-template-columns: 1fr; }
    .about-practice__img { aspect-ratio: 4 / 3; }
  }
  .page-section { max-width: var(--container-max); margin-inline: auto; padding: var(--space-xl) var(--space-md); }
  .page-section + .page-section { padding-block-start: 0; }

  .about-clinic__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: var(--space-lg); margin-block-start: var(--space-lg); }
  .about-clinic__item h3 { margin: 0 0 var(--space-xs); font-size: var(--font-size-md); color: var(--main); }
  .about-clinic__item p { margin: 0; color: var(--text-muted); }

  .about-staff__body { max-width: 48rem; font-size: var(--font-size-md); line-height: 1.7; }
  .team__intro h2 { margin: var(--space-sm) 0 var(--space-md); font-size: var(--font-size-3xl); }
  /* Doctors and staff sit in one section so the two groups read together. */
  .team__group { margin-block-start: var(--space-xl); }
  .team__label { margin: 0 0 var(--space-md); font-size: var(--font-size-xs); letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-muted); }
  .about-clinic { position: relative; isolation: isolate; overflow: hidden; background: var(--solid-bg); }
</style>
