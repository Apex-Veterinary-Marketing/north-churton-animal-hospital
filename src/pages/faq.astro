---
// Aggregates every service's FAQs into one site-wide FAQ page, since
// Skeleton has no separate "site FAQs" collection — services already
// model FAQs (content.config.ts: services.faqs) and that's the richest
// source of real Q&A content a client will have. See Skeleton-Build-Spec.md
// §10 ("LLM data" — favor Q&A-shaped content).
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { getAllServices } from "../lib/data/services";
import { getSiteInfo } from "../lib/data/site";
import { withTrackingPhone } from "../lib/utils/phone";
import bannerPhoto from "../assets/site/banners/cat-63.jpg";

const site = await getSiteInfo();
const services = await getAllServices();
// Answers may carry tel: links — route them to the tracking number like service pages do.
const faqs = services.flatMap((s) => s.data.faqs).map((f) => ({ ...f, answer: withTrackingPhone(f.answer, site) }));
---

<BaseLayout title="FAQs" description="Answers to common questions about visits, payment options, emergencies and pet care at North Churton Animal Hospital, a full-service veterinary hospital in Hillsborough, NC.">
  <PageHeaderBanner heading="Frequently Asked Questions" image={bannerPhoto} imageAlt="Two veterinarians examining a Persian cat" />
  <div class="page-section">
    <FaqAccordion faqs={faqs} />
  </div>
</BaseLayout>

<style>
  .page-section { max-width: 48rem; margin-inline: auto; padding: var(--space-xl) var(--space-md); }
</style>
