---
// Generic forms hub — no dedicated "forms list" collection exists in
// Skeleton's content model, so this ships as a single-form placeholder
// page (New Patient Form) an AI/dev extends with more embeds per client
// as needed. See Skeleton-Build-Spec.md §8.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeaderBanner from "../components/PageHeaderBanner.astro";
import GravityFormEmbed from "../components/GravityFormEmbed.astro";
import banner from "../assets/services/photos/service-20-content2.jpg";
---

<BaseLayout title="New Client Registration" description="New to North Churton Animal Hospital in Hillsborough, NC? Register your pet online before your first visit to save time when you arrive for check-in.">
  <PageHeaderBanner heading="New Client Registration" image={banner} imageAlt="Happy golden retriever" />
  <div class="page-section">
    <GravityFormEmbed formId="new-patient" context="general-info" heading="Register Your Pet" />
  </div>
</BaseLayout>

<style>
  .page-section { max-width: 40rem; margin-inline: auto; padding: var(--space-xl) var(--space-md); }
</style>
